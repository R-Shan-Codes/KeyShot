<Window x:Class="ShotgunKeyboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyShot"
        Width="640"
        Height="420"
        MinWidth="520"
        MinHeight="340">
    <Grid Margin="32">
        <StackPanel>
            <TextBlock Text="KeyShot" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Keyboard sound engine — Phase 0 Foundation" Margin="0,8,0,28" Opacity="0.7" />

            <Border Padding="20" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Status" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Foundation build is ready." Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Phase 1 will add global keyboard detection." Margin="0,28,0,0" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Window>
