<Window x:Class="ShotgunKeyboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyShot"
        Width="500"
        Height="650"
        MinWidth="460"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="Bold">KeyShot</TextBlock>
                    <TextBlock Margin="0,4,0,0" Foreground="Gray">Keyboard sound effects</TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Padding="10,6" CornerRadius="14" Background="#E8F5E9">
                    <TextBlock x:Name="StatusText" Foreground="#2E7D32" FontWeight="SemiBold" Text="● ACTIVE" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="0,24,0,0" Padding="16" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="Gray">PLAYLIST</TextBlock>
                    <ComboBox x:Name="WeaponComboBox" Margin="0,6,0,0" Width="300" HorizontalAlignment="Left" FontSize="18" DisplayMemberPath="DisplayName" SelectionChanged="WeaponComboBox_OnSelectionChanged" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" Padding="16" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="Gray">PLAYBACK</TextBlock>
                    <ComboBox x:Name="PlaybackModeComboBox" Margin="0,6,0,0" Width="300" HorizontalAlignment="Left" FontSize="16" SelectionChanged="PlaybackModeComboBox_OnSelectionChanged" />
                    <TextBlock Margin="0,6,0,0" Foreground="Gray">Random = any playlist sound. Selected = assign sounds to keyboard regions.</TextBlock>
                </StackPanel>
            </Border>

            <Border x:Name="LayerEditorPanel" Grid.Row="3" Margin="0,14,0,0" Padding="16" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="Gray">SELECTED LAYERS</TextBlock>
                    <TextBlock x:Name="LayerEditorHint" Margin="0,4,0,12" Foreground="Gray" Text="Choose a keyboard layer and assign one playlist sound." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LayerComboBox" Grid.Column="0" Margin="0,0,6,0" FontSize="15" />
                        <ComboBox x:Name="LayerSoundComboBox" Grid.Column="1" Margin="6,0,0,0" FontSize="15" DisplayMemberPath="DisplayName" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="34" Margin="0,0,6,0" Click="AssignLayerButton_OnClick">Assign sound</Button>
                        <Button Grid.Column="1" Height="34" Padding="14,0" Click="ClearLayerButton_OnClick">Clear</Button>
                    </Grid>
                    <ListBox x:Name="LayerMappingsList" Margin="0,10,0,0" Height="150" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock FontSize="15" FontWeight="SemiBold">Volume</TextBlock>
                    <TextBlock x:Name="VolumeText" HorizontalAlignment="Right" Foreground="Gray" Text="78%" />
                </Grid>
                <Slider Grid.Row="1" x:Name="VolumeSlider" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="78" TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="VolumeSlider_OnValueChanged" />
            </Grid>

            <Button Grid.Row="5" x:Name="EnableButton" Margin="0,22,0,0" Height="42" FontSize="15" FontWeight="SemiBold" Click="EnableButton_OnClick">Disable KeyShot</Button>

            <Border Grid.Row="6" Margin="0,20,0,0" Padding="16" Background="#F6F6F6" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Foreground="Gray">Last key</TextBlock>
                        <TextBlock x:Name="LastKeyText" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Waiting..." />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Foreground="Gray">Sound bank</TextBlock>
                        <TextBlock x:Name="SoundBankText" HorizontalAlignment="Right" FontWeight="SemiBold" Text="4 variations" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Foreground="Gray">Enter key</TextBlock>
                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="Heavy shot" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
