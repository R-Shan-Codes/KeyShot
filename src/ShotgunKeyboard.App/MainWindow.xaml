<Window x:Class="ShotgunKeyboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyShot - Phase 1"
        Width="420"
        Height="240"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="24" FontWeight="SemiBold">Global Keyboard Input</TextBlock>
            <TextBlock Margin="0,12,0,0">Press any key anywhere in Windows.</TextBlock>
            <TextBlock x:Name="LastKeyText"
                       Margin="0,24,0,0"
                       FontSize="28"
                       FontWeight="Bold"
                       Text="Waiting..." />
        </StackPanel>
    </Grid>
</Window>
