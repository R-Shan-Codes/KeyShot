<Window x:Class="ShotgunKeyboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyShot"
        Width="520"
        Height="720"
        MinWidth="480"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="Bold">KeyShot</TextBlock>
                    <TextBlock Margin="0,4,0,0" Foreground="Gray">Keyboard sound effects</TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Padding="10,6" CornerRadius="14" Background="#E8F5E9">
                    <TextBlock x:Name="StatusText" Foreground="#2E7D32" FontWeight="SemiBold" Text="● ACTIVE" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="0,24,0,0" Padding="16" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="Gray">PLAYLIST</TextBlock>
                    <ComboBox x:Name="WeaponComboBox" Margin="0,6,0,0" Width="300" HorizontalAlignment="Left" FontSize="18" DisplayMemberPath="DisplayName" SelectionChanged="WeaponComboBox_OnSelectionChanged" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" Padding="16" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="Gray">PLAYBACK</TextBlock>
                    <ComboBox x:Name="PlaybackModeComboBox" Margin="0,6,0,0" Width="300" HorizontalAlignment="Left" FontSize="16" SelectionChanged="PlaybackModeComboBox_OnSelectionChanged" />

                    <TextBlock Margin="0,18,0,8" FontSize="13" Foreground="Gray">SELECTED LAYER SOUNDS</TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontWeight="SemiBold">Alphanumeric</TextBlock>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AlphanumericSoundComboBox" DisplayMemberPath="DisplayName" Tag="Alphanumeric" SelectionChanged="LayerMappingSound_OnSelectionChanged" />
                        <TextBlock Grid.Row="1" Margin="0,7,0,0" FontWeight="SemiBold">Function</TextBlock>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FunctionSoundComboBox" Margin="0,7,0,0" DisplayMemberPath="DisplayName" Tag="Function" SelectionChanged="LayerMappingSound_OnSelectionChanged" />
                        <TextBlock Grid.Row="2" Margin="0,7,0,0" FontWeight="SemiBold">Navigation</TextBlock>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="NavigationSoundComboBox" Margin="0,7,0,0" DisplayMemberPath="DisplayName" Tag="Navigation" SelectionChanged="LayerMappingSound_OnSelectionChanged" />
                        <TextBlock Grid.Row="3" Margin="0,7,0,0" FontWeight="SemiBold">Arrow</TextBlock>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ArrowsSoundComboBox" Margin="0,7,0,0" DisplayMemberPath="DisplayName" Tag="Arrows" SelectionChanged="LayerMappingSound_OnSelectionChanged" />
                        <TextBlock Grid.Row="4" Margin="0,7,0,0" FontWeight="SemiBold">Numpad</TextBlock>
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="NumpadSoundComboBox" Margin="0,7,0,0" DisplayMemberPath="DisplayName" Tag="Numpad" SelectionChanged="LayerMappingSound_OnSelectionChanged" />
                        <TextBlock Grid.Row="5" Margin="0,7,0,0" FontWeight="SemiBold">Modifier</TextBlock>
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="ModifiersSoundComboBox" Margin="0,7,0,0" DisplayMemberPath="DisplayName" Tag="Modifiers" SelectionChanged="LayerMappingSound_OnSelectionChanged" />
                        <TextBlock Grid.Row="6" Margin="0,7,0,0" FontWeight="SemiBold">Space</TextBlock>
                        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="SpaceSoundComboBox" Margin="0,7,0,0" DisplayMemberPath="DisplayName" Tag="Space" SelectionChanged="LayerMappingSound_OnSelectionChanged" />
                        <TextBlock Grid.Row="7" Margin="0,7,0,0" FontWeight="SemiBold">Enter</TextBlock>
                        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="EnterSoundComboBox" Margin="0,7,0,0" DisplayMemberPath="DisplayName" Tag="Enter" SelectionChanged="LayerMappingSound_OnSelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock FontSize="15" FontWeight="SemiBold">Volume</TextBlock>
                    <TextBlock x:Name="VolumeText" HorizontalAlignment="Right" Foreground="Gray" Text="78%" />
                </Grid>
                <Slider Grid.Row="1" x:Name="VolumeSlider" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="78" TickFrequency="10" ValueChanged="VolumeSlider_OnValueChanged" />
            </Grid>

            <Button Grid.Row="4" x:Name="EnableButton" Margin="0,22,0,0" Height="42" FontSize="15" FontWeight="SemiBold" Click="EnableButton_OnClick">Disable KeyShot</Button>
        </Grid>
    </ScrollViewer>
</Window>
